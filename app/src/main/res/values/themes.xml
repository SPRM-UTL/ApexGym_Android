<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ApexGym" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/apex_orange</item>
        <item name="android:statusBarColor">@color/apex_bg_screen</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ApexGym" parent="Base.Theme.ApexGym" />

    <style name="ShapeAppearanceOverlay.Apex.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Apex.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Apex.TabSmall" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Material3.Chip.Choice" parent="Widget.Material3.Chip.Filter" />
</resources>
