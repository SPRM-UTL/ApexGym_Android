<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDenominacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/apex_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipoDenominacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/apex_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMenos"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:contentDescription="Disminuir cantidad"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/apex_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCantidad"
                android:layout_width="56dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/apex_text_primary"
                android:textColorHint="@color/apex_nav_inactive"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMas"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_orange_light"
                android:clickable="true"
                android:contentDescription="Aumentar cantidad"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/apex_orange"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:minWidth="84dp"
            android:text="$0.00"
            android:textColor="@color/apex_text_secondary"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/apex_stroke_light" />
</LinearLayout>
