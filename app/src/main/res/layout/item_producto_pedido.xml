<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvProductoPedidoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/apex_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProductoPedidoStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/apex_text_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvProductoPedidoCosto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/apex_orange"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMenosPedido"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:contentDescription="Disminuir cantidad"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/apex_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCantidadPedido"
                android:layout_width="56dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/apex_text_primary"
                android:textColorHint="@color/apex_nav_inactive"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMasPedido"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_orange_light"
                android:clickable="true"
                android:contentDescription="Aumentar cantidad"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/apex_orange"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/vDividerPedido"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/apex_stroke_light" />
</LinearLayout>
