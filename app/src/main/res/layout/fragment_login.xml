<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".feature.main.LoginFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="26dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4" />

        <!-- ======================================================= -->
        <!-- 1. LOGO OFICIAL APEX GYM + ENCABEZADO                   -->
        <!-- ======================================================= -->
        <ImageView
            android:id="@+id/ivLogoApex"
            android:layout_width="210dp"
            android:layout_height="84dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_apex_gym" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_badge_vip_outline"
            android:letterSpacing="0.06"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/login_badge"
            android:textColor="@color/apex_orange"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:text="@string/login_card_title"
            android:textColor="@color/apex_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start"
            android:text="@string/login_card_subtitle"
            android:textColor="@color/apex_text_secondary"
            android:textSize="14sp" />

        <!-- ======================================================= -->
        <!-- 2. CAMPOS DEL ENDPOINT (/api/clientes/verificarCredenciales) -->
        <!-- ======================================================= -->

        <!-- Campo 1: Correo electrónico (email) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCorreo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:hint="@string/login_email_label"
            app:boxBackgroundColor="@color/apex_bg_screen"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/apex_orange"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/apex_orange"
            app:startIconDrawable="@drawable/ic_mail_outline"
            app:startIconTint="@color/apex_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="@color/apex_text_primary"
                android:textSize="14.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo 2: Contraseña (contrasenia) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContrasena"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/login_password_label"
            app:boxBackgroundColor="@color/apex_bg_screen"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxStrokeColor="@color/apex_orange"
            app:boxStrokeWidth="1dp"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/apex_text_secondary"
            app:hintTextColor="@color/apex_orange"
            app:startIconDrawable="@drawable/ic_lock_outline"
            app:startIconTint="@color/apex_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/apex_text_primary"
                android:textSize="14.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Enlace de recuperación -->
        <TextView
            android:id="@+id/tvRecuperar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="6dp"
            android:text="@string/login_forgot_password"
            android:textColor="@color/apex_orange"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ======================================================= -->
        <!-- 3. BOTÓN PRINCIPAL DE ACCIÓN                            -->
        <!-- ======================================================= -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/login_btn_submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/apex_orange"
            app:cornerRadius="28dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ======================================================= -->
        <!-- 4. PIE DE PÁGINA: Enlace a Registro                     -->
        <!-- ======================================================= -->
        <LinearLayout
            android:id="@+id/llIrARegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                android:textColor="@color/apex_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRegistrarse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp"
                android:text="@string/login_go_to_register"
                android:textColor="@color/apex_orange"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
