<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apex_bg_screen"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp">

        <!-- Header with Back/Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/flClose"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_white_elevated"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/apex_text_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Historial de Cortes"
                android:textColor="@color/apex_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/flFilter"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_white_elevated"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_filter_funnel"
                    app:tint="@color/apex_text_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:overScrollMode="never"
            android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:paddingEnd="18dp">

            <!-- Chips: Todos, Validados, Pendientes, Este mes, Mes anterior -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_search_bar"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_search"
            app:tint="@color/apex_nav_inactive" />

        <EditText
            android:id="@+id/etSearchCortes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buscar por caja, responsable, fecha..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/apex_text_primary"
            android:textColorHint="@color/apex_nav_inactive"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Cortes List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorialCortes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/llEmptyCortes"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_wallet_card"
            app:tint="@color/apex_nav_inactive" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No hay cortes registrados"
            android:textColor="@color/apex_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Los cortes de caja aparecerán aquí"
            android:textColor="@color/apex_nav_inactive"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>