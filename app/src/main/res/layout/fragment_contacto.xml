<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#222B45"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos Personales"
            android:textSize="16sp"
            android:textColor="#7A8194"
            android:layout_marginBottom="36dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Teléfono"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#fd6900"
                    android:hint="1999-04-23"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Dirección"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#fd6900"
                    android:hint="Calle Imaginaria"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Contacto de Emergencia"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etContactoENombre"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#fd6900"
                    android:hint="Juan Pablo Pérez Mendoza"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Telefono Emergencia"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etContactoETelefono"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#fd6900"
                    android:hint="4778392039"
                    android:inputType="phone"
                    android:padding="14dp"
                    android:singleLine="true" />
            </LinearLayout>

        <Button
            android:id="@+id/btnRegistro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Registrarme"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#fd6900"
            android:layout_marginTop="28dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes una cuenta? "
                android:textColor="#7A8194" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="Iniciar Sesión"
                android:textColor="#fd6900"
                android:textStyle="bold" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressRegistro"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>