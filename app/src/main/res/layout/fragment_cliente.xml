<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#222B45"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos Personales"
            android:textSize="16sp"
            android:textColor="#7A8194"
            android:layout_marginBottom="36dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="500dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Nombre"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="Ángel Guillermo"
                    android:inputType="textEmailAddress"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Apellido Paterno"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etApePaterno"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="Cuellar"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Apellido Materno"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etApeMaterno"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="Cuellar"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Fecha de Nacimiento"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFechaNacimiento"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="1999-04-23"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Genero"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGenero"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="Masculino"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Teléfono"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="1999-04-23"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:inputType="phone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Dirección"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="Calle Imaginaria"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Contacto de Emergencia"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etContactoENombre"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="Juan Pablo Pérez Mendoza"
                    android:padding="14dp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="Telefono Emergencia"
                    android:textColor="#222B45"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etContactoETelefono"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:backgroundTint="#5267DF"
                    android:hint="4778392039"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:inputType="phone" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnRegistro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Registrarme"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267DF"
            android:layout_marginTop="28dp" />

    </LinearLayout>

</ScrollView>