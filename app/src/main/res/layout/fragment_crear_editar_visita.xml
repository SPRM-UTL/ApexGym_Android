<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apex_bg_screen"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/flClose"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_white_elevated"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/apex_text_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:text="Nueva Visita / Prospecto"
                android:textColor="@color/apex_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="46dp"
                android:layout_height="46dp" />
        </LinearLayout>

        <!-- Basic Info Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Información Básica"
            android:textColor="@color/apex_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/apex_stroke_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreCompleto"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Nombre Completo *"
                        android:inputType="textPersonName"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/apex_orange"
                        app:boxStrokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:hintTextColor="@color/apex_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTelefono"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Teléfono *"
                            android:inputType="phone"
                            android:textColor="@color/apex_text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/apex_orange"
                        app:boxStrokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:hintTextColor="@color/apex_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Email"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/apex_text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <AutoCompleteTextView
                        android:id="@+id/actvOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Origen del Lead *"
                        android:inputType="none"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <AutoCompleteTextView
                        android:id="@+id/actvEstado"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Estado Inicial *"
                        android:inputType="none"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Intereses y Preferencias -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Intereses y Preferencias"
            android:textColor="@color/apex_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/apex_stroke_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etObjetivo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Objetivo Principal (ej. Bajar de peso, ganar masa, etc.)"
                        android:inputType="text"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/apex_orange"
                        app:boxStrokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:hintTextColor="@color/apex_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPresupuestoMin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Presupuesto Mín (S/)"
                            android:inputType="numberDecimal"
                            android:textColor="@color/apex_text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/apex_orange"
                        app:boxStrokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:hintTextColor="@color/apex_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPresupuestoMax"
                            android.layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Presupuesto Máx (S/)"
                            android:inputType="numberDecimal"
                            android:textColor="@color/apex_text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHorarioPreferido"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Horario Preferido (ej. Mañanas 7-9am, Noches 7-9pm)"
                        android:inputType="text"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <AutoCompleteTextView
                        android:id="@+id/actvNivelInteres"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Nivel de Interés *"
                        android:inputType="none"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReferidoPor"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Referido por (opcional)"
                        android:inputType="text"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dirección -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Dirección"
            android:textColor="@color/apex_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/apex_stroke_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/apex_orange"
                    app:boxStrokeWidth="2dp"
                    app:cornerRadius="12dp"
                    app:hintTextColor="@color/apex_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Dirección Completa"
                        android:inputType="textPostalAddress"
                        android:textColor="@color/apex_text_primary"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/apex_orange"
                        app:boxStrokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:hintTextColor="@color/apex_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDistrito"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Distrito"
                            android:inputType="text"
                            android:textColor="@color/apex_text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/apex_orange"
                        app:boxStrokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:hintTextColor="@color/apex_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCiudad"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Ciudad"
                            android:inputType="text"
                            android:textColor="@color/apex_text_primary"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnUsarUbicacionActual"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Usar Mi Ubicación Actual"
                    android:textAllCaps="false"
                    android:textColor="@color/apex_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_location"
                    app:iconGravity="start"
                    app:iconPadding="8dp"
                    app:strokeColor="@color/apex_orange"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notas Iniciales -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Notas Iniciales"
            android:textColor="@color/apex_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/apex_stroke_light">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/apex_orange"
                app:boxStrokeWidth="2dp"
                app:cornerRadius="16dp"
                app:hintTextColor="@color/apex_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotasIniciales"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top"
                    android:hint="Notas adicionales sobre la visita..."
                    android:inputType="textMultiLine"
                    android:maxLines="5"
                    android:textColor="@color/apex_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btnCancelar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/apex_orange"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:strokeColor="@color/apex_orange"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/apex_orange"
                android:text="Guardar Visita"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>