<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pago en Efectivo"
            android:textColor="@color/apex_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTotalPagarEfectivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="S/ 167.14"
            android:textColor="@color/apex_orange"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Importe Recibido -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/apex_orange"
        app:boxStrokeWidth="2dp"
        app:cornerRadius="16dp"
        app:hintTextColor="@color/apex_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etImporteRecibido"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:hint="Importe Recibido"
            android:inputType="numberDecimal"
            android:textColor="@color/apex_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Amount Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="importes rápidos"
            android:textColor="@color/apex_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuick50"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="S/ 50"
                android:textAllCaps="false"
                android:textColor="@color/apex_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/apex_orange"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/btnQuick100"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:text="S/ 100"
                android:textAllCaps="false"
                android:textColor="@color/apex_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/apex_orange"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/btnQuick200"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="S/ 200"
                android:textAllCaps="false"
                android:textColor="@color/apex_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/apex_orange"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickExacto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Importe Exacto"
                android:textAllCaps="false"
                android:textColor="@color/apex_orange"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/apex_orange"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/btnQuickRedondeo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:text="S/ 170"
                android:textAllCaps="false"
                android:textColor="@color/apex_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/apex_orange"
                app:strokeWidth="1.5dp" />

            <Button
                android:id="@+id/btnQuick500"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="S/ 500"
                android:textAllCaps="false"
                android:textColor="@color/apex_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/apex_orange"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Change Display -->
    <LinearLayout
        android:id="@+id/llVuelto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@color/apex_orange_translucent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VUELTO"
            android:textColor="@color/apex_orange"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVuelto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="S/ 32.86"
            android:textColor="@color/apex_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelarEfectivo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/apex_orange"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:strokeColor="@color/apex_orange"
            app:strokeWidth="1.5dp" />

        <Button
            android:id="@+id/btnConfirmarEfectivo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/apex_orange"
            android:text="Confirmar Pago"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
